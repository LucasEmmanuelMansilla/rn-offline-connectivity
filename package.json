{
  "name": "offline-connectivity",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zustand": {
      "react-native": "./src/zustand/index.ts",
      "types": "./dist/zustand/index.d.ts",
      "default": "./dist/zustand/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "scripts": {
    "test": "jest",
    "build": "tsc --pretty false"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": ">=12.0.0",
    "react": ">=18",
    "react-native": ">=0.76",
    "zustand": ">=5"
  },
  "peerDependenciesMeta": {
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "^19.3.0",
    "jest": "30.5.2",
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "zustand": "^5.0.16"
  }
}
